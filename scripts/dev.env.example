# 로컬 개발용 설정값 예시. 복사해서 scripts/dev.env 로 쓰세요. (scripts/dev.env 는 git 에 올라가지 않아요)
# 값은 `npx supabase status` 에서 확인할 수 있어요.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=로컬-service-role-key
ADMIN_INITIAL_PASSWORD=local-test-pass-1234
# AI 를 실제로 쓰려면 키를 넣고, 가짜 서버(scripts/mock-anthropic.mjs)로 테스트하려면 아래 두 줄을 쓰세요.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:54401
NO_PROXY=127.0.0.1,localhost
# (로컬 테스트 전용) 황금 동물 확률을 바꿔서 확인할 때. 예) 1 이면 항상 황금. 배포 환경에는 절대 넣지 마세요.
# GOLDEN_RATE_FOR_TEST=1
