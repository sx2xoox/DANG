{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["../supabase/functions/_shared/*"] }
  },
  "include": ["src", "../supabase/functions/_shared/boxes.ts", "../supabase/functions/_shared/safety.ts", "../supabase/functions/_shared/fallbackAnimals.ts"]
}
