# Supabase 프로젝트 > Project Settings > API 에서 복사하세요.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# (선택) 서버 함수 주소를 따로 쓸 때만. 비워두면 VITE_SUPABASE_URL/functions/v1 을 씁니다.
VITE_FUNCTIONS_URL=
# (권장) 사이트 주소. 짧은 도메인을 연결했다면 그 주소를 넣으세요. 예) https://dawoong.kr
# 링크 미리보기 이미지, 고민 동물 카드 아래 주소, 릴스·쇼츠용 링크에 쓰여요. 비워두면 지금 접속한 주소를 써요.
VITE_SITE_URL=
